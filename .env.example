# Tavşan Uykusu — ortam değişkenleri örneği. GERÇEK değerleri .env'e yazın
# (.env ASLA commit edilmez — .gitignore'da). Railway'de bunları dashboard →
# Variables altında tanımlayın.

# --- Veritabanı (production backend) ---
# Railway PostgreSQL eklentisi bunu otomatik sağlar. Lokal geliştirmede tanımsız
# bırakılırsa dosya-tabanlı SQLite'a düşer (sqlite:///./tavsan_local.db).
# Kabul edilen biçimler: postgresql://... veya postgres://... (otomatik normalize).
DATABASE_URL=

# --- Ortam (Faz 5R) ---
# "production" | "development" (varsayılan). production'da ALLOWED_ORIGINS="*"
# YOK SAYILIR (tarayıcı origin'leri reddedilir; mobil native etkilenmez).
ENVIRONMENT=development

# --- JWT auth (Faz 2 / Faz 5R'de zorunlu) ---
# GÜÇLÜ rastgele bir sır üretin: openssl rand -hex 32
# ZORUNLU (min 32 karakter). Tanımsızsa uygulama BAŞLAMAZ — varsayılana düşmez.
JWT_SECRET=

# --- Demo endpoint anahtarı (Faz 5R) ---
# /ask ve /avatar-session korumasız LLM/kredi tetikleyicileriydi; artık X-API-Key
# başlığı ister. TANIMSIZ bırakılırsa bu iki endpoint KAPALIDIR (503) — mobil v1
# bunları kullanmaz, güvenli varsayılan budur. avatar.html demosu için doldurun ve
# sayfayı ?key=<değer> ile açın.
DEMO_API_KEY=
# Opsiyonel süre ayarları (varsayılan: 60 dk access, 30 gün refresh).
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM (mevcut) ---
ANTHROPIC_API_KEY=

# --- ElevenLabs TTS (API katmanı) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- LiveAvatar (HeyGen) — LITE mode görüntü katmanı ---
# API key ASLA frontend'e gitmez; backend /avatar-session kısa ömürlü token üretir.
# NOT: Mevcut avatar modülü LIVEAVATAR_API_KEY okur. HEYGEN_API_KEY spec'te ayrıca
# istendiği için ileriye dönük ayrılmıştır (aynı sağlayıcı; şu an LIVEAVATAR_* kullanılır).
HEYGEN_API_KEY=
LIVEAVATAR_API_KEY=
# Gerçek (İlayda) avatar id — SANDBOX kapalıyken zorunlu. Sandbox'ta yok sayılır.
LIVEAVATAR_AVATAR_ID=
# Kredi disiplini: "true" (default) → sandbox, KREDİ YAKMAZ, yalnız Wayne avatarı,
# oturum ~1 dk. Gerçek avatarla canlı test için "false" yapın.
LIVEAVATAR_SANDBOX=true

# --- E-posta (Faz 6.3) ---
# ÜÇ MOD:
#   resend   → gerçek gönderim (RESEND_API_KEY gerekir)
#   console  → gönderim yok, içerik LOGLANIR. YALNIZ lokal geliştirme! Sıfırlama
#              token'ı uygulama loguna düşer.
#   disabled → gönderim yok, içerik HİÇBİR YERE yazılmaz (ne e-posta ne log).
#              reset-password-request yine 200 döner (e-posta enumeration önlenir),
#              akış sessizce sonlanır. Mobil "yakında" gösterir.
# Boş bırakılırsa: anahtar varsa resend; yoksa production'da disabled, geliştirmede
# console. Resend bağlanınca TEK değişiklik yeter: RESEND_API_KEY tanımlayın.
MAIL_PROVIDER=
RESEND_API_KEY=
# Gönderen adresi. Domain Resend panelinde DOĞRULANMIŞ olmalı; doğrulanana kadar
# Resend'in test adresi kullanılabilir (yalnız kendi hesabınıza gönderir).
MAIL_FROM=Tavşan Uykusu <onboarding@resend.dev>
# Parola sıfırlama e-postasındaki derin bağlantı şeması (mobil app.json ile aynı olmalı).
APP_DEEP_LINK_SCHEME=tavsan-uykusu

# --- Public taban URL (Faz 6.7) ---
# Ses bağlantıları (audio_url / sampleUrl) MUTLAK döner: <base>/audio/<hash>.mp3
# Mobilin göreli path'i yanlış tabanla birleştirme riskini kökten kaldırır.
# Tanımsızsa göreli path (/audio/...) döner — lokal geliştirme davranışı.
# Sonda eğik çizgi OLMASIN.
PUBLIC_BASE_URL=https://tavsan-api-production.up.railway.app

# --- API / CORS ---
# İzinli origin'ler (virgülle ayrılmış). Örn: https://app.example.com,https://x.y
# "*" YALNIZ ENVIRONMENT=development'ta geçerlidir; production'da "*" → deny-all.
# Mobil native istekler Origin başlığı göndermez → CORS onları etkilemez.
ALLOWED_ORIGINS=*
